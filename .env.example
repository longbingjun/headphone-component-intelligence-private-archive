# Copy this file to .env for local development. Never commit real secrets.
APP_COMMIT_SHA=
DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/intelligence
# Keep false for Web, Scheduler and Video Worker. Run
# `python -m server.cli migrate` once before starting application services.
AUTO_MIGRATE=false
IMPORT_ON_START=false
INITIAL_REFRESH_ON_START=false
REBUILD_SITE_ON_START=false
INITIAL_IMAGE_SYNC_ON_START=false

STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace_me
MINIO_SECRET_KEY=replace_me
MINIO_BUCKET=product-images
IMAGE_CACHE_DIR=/app/runtime/image-cache
IMAGE_MIN_READY_RATIO=0.95
IMAGE_FETCH_TIMEOUT_SECONDS=20
IMAGE_FETCH_RETRIES=1
IMAGE_DOWNLOAD_WORKERS=6
IMAGE_BACKFILL_BATCH_SIZE=100
IMAGE_MAX_BYTES=26214400

# Image synchronization is an explicit deployment/maintenance command. The
# existing production MinIO bucket is retained and is never reset on startup.
FULL_IMAGE_SYNC_ON_START=false
IMAGE_SEED_DIR=/app/web/public/images
IMAGE_FULL_SYNC_BATCH_SIZE=50
IMAGE_FULL_SYNC_PAUSE_SECONDS=1
IMAGE_FULL_SYNC_MAX_STAGNANT_BATCHES=2

# Built-in daily refresh (Asia/Shanghai 09:10 by default)
SCHEDULER_ENABLED=false
# Scheduler runs as a dedicated process/container, not inside Web.
SCHEDULER_RUN_IN_WEB=false
SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_HOUR=9
SCHEDULER_MINUTE=10
SCHEDULER_MISFIRE_GRACE_SECONDS=21600
# Test only: a positive value replaces the daily schedule. Production must be 0.
SCHEDULER_TEST_INTERVAL_SECONDS=0
# New/changed products use the configured text model; historical cache hits do
# not spend API calls. The pipeline degrades to evidence-grounded rules if the
# deployment secret is temporarily unavailable.
CRAWL_WITH_AI=false
REFRESH_STATIC_SITE=true

# Daily incremental price lookup. Official pages are checked first; ZOL/JD
# are fallback reference prices only when no explicit official price is found.
PRICE_REFRESH_ENABLED=false
PRICE_REFRESH_BATCH_SIZE=10
PRICE_REFRESH_WORKERS=2

# Dedicated Video Worker (one process, one video at a time). This workflow
# reads creator subtitles first and falls back to hard-subtitle OCR.
# VIDEO_COOKIES_FILE is optional and must point
# to a secret mounted by the deployment platform, never to a committed file.
VIDEO_WORKER_POLL_SECONDS=30
VIDEO_WORKER_MAX_ATTEMPTS=3
VIDEO_WORKER_RETRY_SECONDS=300
VIDEO_WORKER_LEASE_SECONDS=7200
VIDEO_WORKER_TEMP_ROOT=/tmp/video-worker
VIDEO_WORKER_OCR_INTERVAL_SECONDS=0.5
VIDEO_WORKER_REBUILD_SITE=true
VIDEO_COOKIES_FILE=

# OpenAI-compatible text-only endpoint used to correct OCR and select facts.
# Leave unset to use conservative local rules; inject secrets at deployment.
VIDEO_LLM_BASE_URL=
VIDEO_LLM_API_KEY=
VIDEO_LLM_MODEL=deepseek-v4-flash

# Shared OpenAI-compatible text model used by BOM, consumer-claim and
# unboxing-summary enrichment. Inject the key through deployment secrets.
DEFAULT_MODEL_API_URL=
DEFAULT_MODEL_API_KEY=
DEFAULT_MODEL_NAME=deepseek-v4-flash

# Internal deployment is served at the domain root and images are proxied by the app.
PUBLIC_BASE_PATH=/
PUBLIC_IMAGE_BASE=/media
SITE_DIR=/app/site
