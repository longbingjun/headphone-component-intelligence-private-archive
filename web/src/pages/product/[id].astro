  <script>
    (function enhanceDetailNavigation() {
      const navLinks = Array.from(document.querySelectorAll(".detail-section-nav a[href^='#']"));
      const currentSection = document.getElementById("detail-current-section");
      const setCurrentSection = (targetId) => {
        const activeLink = navLinks.find((link) => link.getAttribute("href") === `#${targetId}`);
        if (!activeLink) return;
        navLinks.forEach((link) => {
          if (link === activeLink) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        });
        if (currentSection) currentSection.textContent = `当前：${activeLink.textContent?.trim() || "产品概览"}`;
      };
      const openBomEvidence = (id) => {
        const target = document.getElementById(id);
        if (!(target instanceof HTMLDetailsElement)) return;
        target.open = true;
        target.classList.add("bom-evidence-target");
        window.setTimeout(() => target.classList.remove("bom-evidence-target"), 1800);
      };
      const syncHashNavigation = () => {
        if (window.location.hash.startsWith("#bom-component-")) {
          const targetId = window.location.hash.slice(1);
          openBomEvidence(targetId);
          const groupId = document.getElementById(targetId)?.closest(".bom-evidence-group")?.id;
          setCurrentSection(groupId || "bom-evidence");
        } else if (window.location.hash) {
          setCurrentSection(window.location.hash.slice(1));
        }
      };
      document.querySelectorAll("[data-bom-jump]").forEach((link) => {
        link.addEventListener("click", () => {
          const targetId = link.getAttribute("data-bom-jump") || "";
          openBomEvidence(targetId);
          const groupId = document.getElementById(targetId)?.closest(".bom-evidence-group")?.id;
          setCurrentSection(groupId || "bom-evidence");
        });
      });
      window.addEventListener("hashchange", syncHashNavigation);
      syncHashNavigation();
      if (!("IntersectionObserver" in window)) return;
      const sections = navLinks
        .map((link) => document.querySelector(link.getAttribute("href") || ""))
        // “组件详情与证据”包裹三个证据分组；若同时观察父级和子级，
        // 父级会在组件跳转后覆盖更精确的分组定位。
        .filter((section) => section && section.id !== "bom-evidence");
      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!visible) return;
        setCurrentSection(visible.target.id);
      }, { rootMargin: "-18% 0px -70% 0px", threshold: 0 });
      sections.forEach((section) => observer.observe(section));
    })();
  </script>

