---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase, baseUrl } from "../../lib/paths";
import { resolveImageSrc } from "../../lib/images";
import { computeUnboxModuleMetrics, unboxModuleStyle } from "../../lib/unboxingMetrics";
import { sellingPointTagStyle } from "../../lib/sellingPointTags";
import fs from "node:fs";
import path from "node:path";

export function getStaticPaths() {
  const productsDir = path.join(process.cwd(), "public", "data", "products");
  const files = fs.readdirSync(productsDir).filter((f) => f.endsWith(".json") && f !== "index.json");
  return files.map((file) => {
    const product = JSON.parse(fs.readFileSync(path.join(productsDir, file), "utf-8"));
    return {
      params: { id: product.canonical_id },
      props: { product },
    };
  });
}

const { product } = Astro.props;
const demoCoverByCategory: Record<string, string> = {
  "耳夹式耳机": "clip.svg",
  "耳挂式耳机": "ear-hook.svg",
  "全入耳式耳机": "in-ear.svg",
  "半入耳式耳机": "semi-in-ear.svg",
  "有线耳机": "wired.svg",
  "头戴式耳机": "over-ear.svg",
  "颈挂式蓝牙耳机": "neckband.svg",
  "骨传导耳机": "bone-conduction.svg",
};
const demoCoverSrc = withBase(`/demo-covers/${demoCoverByCategory[product.category] || "in-ear.svg"}`);
const snap = product.cost_snapshot || {};
const market = product.market || {};
type SellingPoint = {
  text?: string;
  category?: string;
  tag?: string;
  tags?: string[];
  consumer_benefit?: string;
  scenario?: string;
  supporting_bom_keys?: string[];
  evidence_quote?: string;
  evidence?: { confidence?: number };
};
const consumerCategories = new Set(["佩戴体验", "音质体验", "通话体验", "续航充电", "连接与智能", "耐用防护", "外观设计"]);
const nonConsumerContext = /公司|生产商|制造商|供应商|包装盒|包装清单|拆解报告|主板|器件型号|料号|物料清单|丝印|镭雕|微控制器|电源管理芯片|保护IC|MOS管|晶振/i;
const strictNonConsumer = /包装盒|包装清单|公司信息|据我爱音频网拆解了解到/i;
const experienceLanguage = /舒适|稳固|轻巧|无感|音质|听感|低频|高频|空间音频|通话|降噪|风噪|续航|快充|小时|连接|多点|防水|防尘|外观|质感|佩戴|低延迟|提升|减少|更/;
const sellingPoints = ((market.consumer_claims || market.selling_points || []) as SellingPoint[])
  .filter((sp) => {
    const text = (sp.text || "").trim();
    const category = (sp.category || sp.tag || "").trim();
    if (!text || !consumerCategories.has(category)) return false;
    if (strictNonConsumer.test(text)) return false;
    return !nonConsumerContext.test(text) || experienceLanguage.test(text);
  });
const sellingPointGroups = Array.from(
  sellingPoints.reduce((groups, claim) => {
    const category = (claim.category || claim.tag || "其他").trim() || "其他";
    const existing = groups.get(category) || [];
    existing.push(claim);
    groups.set(category, existing);
    return groups;
  }, new Map<string, SellingPoint[]>())
).map(([category, claims]) => ({ category, claims, style: sellingPointTagStyle(category) }));
const scenarios = (market.scenarios || []) as string[];
const positioningSummary = (market.positioning_summary || "").trim();
const hasMarket = sellingPoints.length > 0 || scenarios.length > 0 || !!positioningSummary;
const bom = (product.technical_facts || product.teardown_inventory || product.bom_table || []).filter(
  (r: { model?: string; component?: string }) => (r.model || "").trim() || (r.component || "").trim()
);
const unboxing = product.unboxing || null;

type BomEvidenceImage = { url: string; alt?: string; caption?: string; index?: number };
type RelatedSource = {
  kind?: "report" | "video";
  id?: string;
  title?: string;
  published_at?: string;
  publisher?: string;
  source_url?: string;
  video_url?: string;
};
type BomParameter = { label?: string; value?: string; display?: string; evidence_quote?: string };
type BomRow = {
  component?: string;
  brand?: string;
  model?: string;
  specification?: string;
  qty_hint?: string;
  side?: string;
  role?: string;
  classification_reason?: string;
  fact_text?: string;
  side_reason?: string;
  side_status?: string;
  evidence_images?: BomEvidenceImage[];
  evidence?: { confidence?: number; source_type?: string; text?: string };
  parameters?: BomParameter[];
};

const coreBomRows = (bom as BomRow[]).filter((row) => row.role === "core" || row.role === "key");
const structureRows = (bom as BomRow[]).filter((row) => row.role === "structure");
const auxiliaryRows = (bom as BomRow[]).filter((row) => row.role === "auxiliary");
const unidentifiedRows = ((product.data_quality_review_queue || product.bom_table || []) as BomRow[])
  .filter((row) => row.role === "unidentified_marking" || (row as { classification?: string }).classification === "unidentified_marking");
const recognizedBomRows = [...coreBomRows, ...structureRows, ...auxiliaryRows];
const bomGroups = [
  { key: "core", listId: "bom-core", evidenceId: "bom-evidence-core", title: "核心 / 关键 BOM", note: "决定主要功能、性能、安全或射频链路的器件", rows: coreBomRows, icon: "🧠", bg: "#e0f2fe", color: "#0369a1" },
  { key: "structure", listId: "bom-structure", evidenceId: "bom-evidence-structure", title: "结构件", note: "承担固定、屏蔽、缓冲或佩戴连接的机械结构", rows: structureRows, icon: "🧩", bg: "#f3e8ff", color: "#7e22ce" },
  { key: "auxiliary", listId: "bom-auxiliary", evidenceId: "bom-evidence-auxiliary", title: "辅助器件与连接件", note: "接口、连接、按键和状态指示等配套器件", rows: auxiliaryRows, icon: "🔌", bg: "#dcfce7", color: "#15803d" },
];

function formatBomRole(role: string): string {
  if (!role?.trim()) return "—";
  return ({
    major: "核心部件",
    minor: "外围部件",
    core: "核心BOM",
    key: "关键BOM",
    auxiliary: "辅助器件",
    structure: "结构件",
    unidentified_marking: "待识别丝印",
  } as Record<string, string>)[role] || role;
}

function formatBomModel(row: { model?: string; specification?: string }): string {
  return [row.model, row.specification].map((value) => (value || "").trim()).filter(Boolean).join(" · ") || "—";
}

function formatCell(val: string | undefined): string {
  const v = (val || "").trim();
  return v || "—";
}

function bomEvidenceSource(row: BomRow, imageCount: number): string {
  const sourceType = (row.evidence?.source_type || "").toLowerCase();
  const fromVideo = sourceType.includes("video");
  const textSource = fromVideo ? "拆解视频字幕" : "拆解报告原文";
  if (imageCount <= 0) return textSource;
  return `${textSource} + ${imageCount} 张${fromVideo ? "相邻关键帧" : "相邻原图"}`;
}

function splitBulletText(text: string | undefined): string[] {
  return (text || "")
    .split(/[。！？；;]+/)
    .map((item) => item.trim().replace(/^其他方面[，,]?/, ""))
    .filter((item) => item.length >= 4 && !/^下面就来看看/.test(item));
}

function bomFactBullets(row: BomRow, limit = 3, includeSpecification = true): string[] {
  const structured = (row.parameters || [])
    .map((item) => (item.display || ((item.label && item.value) ? `${item.label}：${item.value}` : "")).trim())
    .filter(Boolean);
  if (structured.length > 0) return structured.slice(0, limit);
  const specification = (row.specification || "")
    .split(/\s*\/\s*/)
    .map((item) => item.trim())
    .filter(Boolean)
    .map((item) => `参数：${item}`);
  const clauses = splitBulletText(row.fact_text)
    .flatMap((sentence) => sentence.length > 96
      ? sentence.split(/[，,](?=支持|采用|集成|用于|提供|最高|额定|标称|充电|应用处理器|DSP)/).map((item) => item.trim())
      : [sentence])
    .filter((item) => item.length >= 5 && !/详细资料图|外观一览/.test(item));
  const informative = /用于|支持|采用|集成|提供|电压|容量|主频|频率|功率|尺寸|直径|重量|内存|闪存|蓝牙|充电|保护|时钟|固定|连接|防护|缓冲|密封|材质|弹性|处理器|接口/;
  const ranked = clauses
    .map((text, index) => ({
      text,
      index,
      score: (informative.test(text) ? 4 : 0) + (/\d/.test(text) ? 2 : 0) + (text.length <= 90 ? 1 : 0),
    }))
    .sort((a, b) => b.score - a.score || a.index - b.index)
    .map((item) => item.text);
  const seen = new Set<string>();
  return [...(includeSpecification ? specification : []), ...ranked]
    .filter((item) => {
      const key = item.replace(/[\s，,。；;:/]/g, "").toLowerCase();
      if (!key || seen.has(key)) return false;
      seen.add(key);
      return true;
    })
    .slice(0, limit);
}

function unboxBullets(key: string, mod: UnboxModule): string[] {
  const structured = (mod.display_bullets || [])
    .map((item) => typeof item === "string" ? item : item.text || "")
    .map((item) => item.trim())
    .filter(Boolean);
  if (structured.length > 0) return structured;
  const captionText = (mod.appearance_images || [])
    .map((image) => image.caption || "")
    .filter((caption) => caption && !/^拆解报告[：:]/.test(caption));
  // 旧提取器把报告导语误放进“包装”说明；包装优先采用与包装图片相邻、语义更准确的图注。
  const source = key === "packaging" && captionText.length > 0
    ? captionText
    : [mod.description || "", ...captionText];
  const seen = new Set<string>();
  return source
    .flatMap((text) => splitBulletText(text))
    .filter((item) => {
      const normalized = item.replace(/[，,s]/g, "").toLowerCase();
      if (seen.has(normalized)) return false;
      seen.add(normalized);
      return true;
    });
}

function bomAnchorForKey(key: string): string | null {
  const normalized = (key || "").replace(/\s+/g, "").toLowerCase();
  const index = recognizedBomRows.findIndex((row) =>
    [row.model, row.component].some((value) => (value || "").replace(/\s+/g, "").toLowerCase() === normalized)
  );
  return index >= 0 ? `bom-component-${index + 1}` : null;
}

function bomAnchorForRow(row: BomRow): string {
  return `bom-component-${recognizedBomRows.indexOf(row) + 1}`;
}

// TWS / 开放式耳机（含耳夹式）需要拆分整机/充电盒/单只耳机重量；
// 头戴式/骨传导/有线/颈挂式等单一整机形态只展示一个总重。
const MULTI_PART_WEIGHT_CATEGORIES = new Set([
  "真无线耳机TWS",
  "开放式耳机",
  "耳夹式耳机",
  "耳挂式耳机",
  "全入耳式耳机",
  "半入耳式耳机",
  "待细分耳机",
]);
const isMultiPartWeight = MULTI_PART_WEIGHT_CATEGORIES.has(product.category);
const weightCards = isMultiPartWeight
  ? [
      ["整机重量", snap.weight_g],
      ["充电盒重量", snap.weight_case_g],
      ["单只耳机重量", snap.weight_earbud_g],
    ]
  : [["重量", snap.weight_g]];

const priceLabel =
  snap.price_source_label ||
  ({ official: "官方价", channel: "渠道价", technical: "技术文章价" }[snap.price_layer] ?? "");
const priceCurrency = String(snap.price_currency || "CNY").toUpperCase();
const pricePrefix = ({ CNY: "¥", USD: "US$", EUR: "€", GBP: "£", JPY: "JP¥", KRW: "₩" } as Record<string, string>)[priceCurrency] || `${priceCurrency} `;
const priceTxt =
  snap.price_cny != null
    ? `${pricePrefix}${snap.price_cny}${priceLabel ? `（${priceLabel}）` : ""}`
    : "未检索到官方渠道价";
const priceSourceUrl = typeof snap.price_source_url === "string" ? snap.price_source_url.trim() : "";
const priceDisclaimer = typeof snap.price_disclaimer === "string" ? snap.price_disclaimer.trim() : "";
const launch = product.launch || {};
const launchDisplay = String(launch.display || "上市时间待核验");
const launchSourceUrl = typeof launch.source_url === "string" ? launch.source_url.trim() : "";

type UnboxModule = {
  description?: string;
  accessories?: string[];
  appearance_images?: { url: string; caption?: string; alt?: string }[];
  image_count?: number;
  display_bullets?: ({ text?: string; topic?: string; evidence_quote?: string; priority?: number } | string)[];
  summary_meta?: { method?: string; model?: string; validator?: string };
};

const unboxSections: { key: "packaging" | "charging_case" | "earbuds"; title: string; mod: UnboxModule | null }[] = [
  { key: "packaging", title: "包装", mod: unboxing?.packaging ?? null },
  { key: "charging_case", title: "充电盒", mod: unboxing?.charging_case ?? null },
  { key: "earbuds", title: "耳机", mod: unboxing?.earbuds ?? null },
];

// 原始图片来自 52audio OSS，开启了 Referer 防盗链，浏览器无法直接热链展示，
// 需要用构建阶段缓存的本地文件；未成功缓存的图跳过渲染，避免出现裂图图标。
type ResolvedImage = { src: string; alt?: string; caption?: string };
function resolveImages(images?: { url: string; alt?: string; caption?: string }[]): ResolvedImage[] {
  return (images || [])
    .map((img) => {
      const src = resolveImageSrc(img.url);
      return src ? { src, alt: img.alt, caption: img.caption } : null;
    })
    .filter((img): img is ResolvedImage => img !== null);
}

const resolvedSummaryImages: ResolvedImage[] = resolveImages(
  (product.summary_image_urls || []) as { url: string; alt?: string; caption?: string }[]
);
const resolvedBomEvidenceImages: ResolvedImage[] = resolveImages(
  (bom as BomRow[]).flatMap((row) => row.evidence_images || [])
);
// 详情页首屏只使用原文「开箱 / 外观」模块里的实拍图：耳机本体优先，其次充电盒、包装。
// 不将 summary_image_urls 用作封面，避免把 BOM、芯片或内部结构图误呈现为产品外观。
function coverImageScore(image: ResolvedImage, sectionScore: number): number {
  const description = `${image.alt || ""} ${image.caption || ""}`;
  const overallBonus = /整体|全貌|全景|外观|一览|展示|真机|佩戴|正面|侧面|背面/.test(description) ? 20 : 0;
  const detailPenalty = /特写|内部|拆解|芯片|主板|电池|接口|触点|铭牌|参数|包装盒/.test(description) ? 12 : 0;
  return sectionScore + overallBonus - detailPenalty;
}

const productCover = [
  ...resolveImages(unboxing?.earbuds?.appearance_images).map((image) => ({ image, score: coverImageScore(image, 6) })),
  ...resolveImages(unboxing?.charging_case?.appearance_images).map((image) => ({ image, score: coverImageScore(image, 4) })),
  ...resolveImages(unboxing?.packaging?.appearance_images).map((image) => ({ image, score: coverImageScore(image, 2) })),
].sort((a, b) => b.score - a.score)[0]?.image || null;
const productName = [product.brand, product.model].filter(Boolean).join(" ") || product.canonical_id;
const completeness = Math.round((snap.data_completeness || 0) * 100);
const unboxingSectionCoverage = unboxing?.completeness != null ? Math.round((unboxing.completeness || 0) * 100) : null;
const reportCount = (product.report_ids || []).length;
const relatedIntelligence = ((product.related_intelligence || []) as RelatedSource[])
  .filter((source) => source.id || source.source_url || source.video_url);

// 静态兜底统一回到工作台。客户端会读取 BaseLayout 在用户点击产品链接时保存的
// 来源上下文，并替换为“返回工作台 / 同类对比 / 跨品类对比 / 情报分析页”。
const staticBackHref = withBase("/");

const allLightboxImages: ResolvedImage[] = [
  ...resolvedSummaryImages,
  ...unboxSections.flatMap(({ mod }) => (mod ? resolveImages(mod.appearance_images) : [])),
  ...resolvedBomEvidenceImages,
];
const lightboxJson = JSON.stringify(allLightboxImages);
---

<BaseLayout title={`${product.brand} ${product.model}`} activeNav="compare">
  <div class="mb-4 text-sm">
    <a id="compare-back-link" href={staticBackHref} class="text-[var(--muted)]">
      ← 返回工作台
    </a>
  </div>

  <script define:vars={{ baseUrl }}>
    (function () {
      var STORAGE_KEY = "cost-product-return-context-v1";
      var link = document.getElementById("compare-back-link");
      if (!link) return;
      try {
        var stored = sessionStorage.getItem(STORAGE_KEY);
        var context = stored ? JSON.parse(stored) : null;
        var currentPath = window.location.pathname.replace(/\/+$/, "");
        var returnUrl = context && typeof context.returnHref === "string"
          ? new URL(context.returnHref, window.location.origin)
          : null;
        var looksInternal =
          context &&
          context.productPath === currentPath &&
          returnUrl &&
          returnUrl.origin === window.location.origin &&
          returnUrl.pathname.startsWith(baseUrl) &&
          typeof context.returnLabel === "string" &&
          context.returnLabel.startsWith("返回");
        if (looksInternal) {
          link.setAttribute("href", returnUrl.pathname + returnUrl.search + returnUrl.hash);
          link.textContent = "← " + context.returnLabel;
        }
      } catch (err) {
        /* 来源上下文不可用时保留“返回工作台”兜底 */
      }
    })();
  </script>

  <div class="detail-page-shell">
    <aside class="detail-sidebar">
    <nav class="detail-section-nav" aria-label="产品详情页目录">
      <div class="detail-section-nav__title">
        <small>产品详情</small>
        <strong>{product.model || product.brand}</strong>
        <em id="detail-current-section">当前：产品概览</em>
      </div>
      <span class="detail-section-nav__kicker">页面定位</span>
      <a href="#overview">产品概览</a>
      {hasMarket && <a href="#positioning">定位与卖点</a>}
      {unboxing && <a href="#unboxing">开箱与外观</a>}
      <a href="#specifications">核心参数</a>
      <a class="detail-section-nav__parent" href="#bom">物料清单（BOM）</a>
      <div class="detail-section-nav__subnav" aria-label="物料清单子目录">
        {bomGroups.map((group) => group.rows.length > 0 && <a href={`#${group.listId}`}>{group.title}</a>)}
        <a class="detail-section-nav__subparent" href="#bom-evidence">组件详情与证据</a>
        <div class="detail-section-nav__third-level">
          {bomGroups.map((group) => group.rows.length > 0 && <a href={`#${group.evidenceId}`}>{group.title}证据</a>)}
        </div>
      </div>
      {resolvedSummaryImages.length > 0 && <a href="#summary-images">物料总结图</a>}
    </nav>
    </aside>

    <div class="detail-page-content">
  <section id="overview" class="detail-hero">
    <div class="detail-hero-cover" aria-label={`${productName} 产品外观图`}>
      {productCover ? (
        <button
          type="button"
          class="detail-cover-button"
          data-lightbox-index={allLightboxImages.findIndex((img) => img.src === productCover.src)}
        >
          <img src={productCover.src} alt={productCover.alt || productCover.caption || productName} />
          <span>查看外观图</span>
        </button>
      ) : (
        <div class="detail-cover-fallback detail-demo-cover" aria-label={`${product.category}自制示意封面，不是产品实拍图`}>
          <img src={demoCoverSrc} alt={`${product.category}自制示意封面`} />
          <span>自制类型示意封面 · 非产品实拍图</span>
        </div>
      )}
    </div>

    <div class="detail-hero-main">
      <div class="detail-breadcrumb"><span>产品档案</span><i>/</i><span>{product.category}</span></div>
      <div class="detail-title-line">
        <span class="detail-category-badge">{product.category}</span>
      </div>
      <h1>{productName}</h1>
      <p class="detail-product-id">产品档案 ID：{product.canonical_id}</p>
      {hasMarket ? (
        <div class="detail-summary">
          <span>产品摘要</span>
          <p>{positioningSummary || (sellingPoints[0]?.text || "已收录拆解与市场信息，可继续查看外观、物料与关联报告。")}</p>
          {scenarios.length > 0 && (
            <div class="detail-scenario-list">
              {scenarios.slice(0, 4).map((scenario) => <em>{scenario}</em>)}
            </div>
          )}
        </div>
      ) : (
        <div class="detail-summary detail-summary--empty">
          <span>产品摘要</span><p>已收录拆解档案；市场定位信息将在后续数据更新中补充。</p>
        </div>
      )}
      {relatedIntelligence.length > 0 && (
        <details id="related-intelligence" class="detail-related-intelligence" open>
          <summary>
            <span>关联情报</span>
            <small>{relatedIntelligence.length} 条可追溯来源</small>
          </summary>
          <ul>
            {relatedIntelligence.map((source) => (
              <li>
                <span class:list={["detail-source-kind", source.kind === "video" && "detail-source-kind--video"]}>
                  {source.kind === "video" ? "视频" : "报告"}
                </span>
                <div>
                  <strong>{source.title || `${source.kind === "video" ? "拆解视频" : "拆解报告"} ${source.id}`}</strong>
                  <small>{[source.published_at, source.publisher].filter(Boolean).join(" · ") || `来源编号 ${source.id}`}</small>
                </div>
                <nav aria-label={`${source.title || source.id} 来源链接`}>
                  {source.source_url && (
                    <a href={source.source_url} target="_blank" rel="noopener noreferrer">来源原文 ↗</a>
                  )}
                  {source.kind === "video" && source.video_url && (
                    <a href={source.video_url} target="_blank" rel="noopener noreferrer">播放视频 ↗</a>
                  )}
                </nav>
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>

    <aside class="detail-hero-metrics" aria-label="产品核心信息">
      <div class="detail-metric detail-metric--price">
        <span>可溯源价格</span>
        {priceSourceUrl && snap.price_cny != null ? (
          <a href={priceSourceUrl} target="_blank" rel="noopener noreferrer" title="打开价格来源">
            {priceTxt}<small>查看来源 ↗</small>
